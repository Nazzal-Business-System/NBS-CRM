  "devDependencies": {"prisma": "^7.0.0", "tsx": "^4.20.0", "tsup": "^8.5.0", "@types/express": "^5.0.0", "@types/cors": "^2.8.19", "@types/node": "^22.0.0", "@types/pg": "^8.15.0"}
